{
  "schemaVersion": 1,
  "slug": "google-workspace",
  "name": "Google Workspace",
  "description": "Connect Gmail, Calendar, Drive and Docs through standard Google APIs, or use Google\u2019s preview MCP services.",
  "categories": [
    "productivity",
    "communication",
    "content"
  ],
  "featured": true,
  "branding": {
    "logoUrl": "/brands/apps/google-people.svg"
  },
  "urlPatterns": [
    "https://workspace.google.com/*"
  ],
  "docsUrl": "https://developers.google.com/workspace/guides/enable-apis",
  "redirectConstraints": "https-or-loopback-http",
  "methods": [
    {
      "key": "customer-workspace-api",
      "label": "Google APIs (OAuth)",
      "transport": "rest_api",
      "auth": "oauth",
      "capabilityProfile": {
        "key": "write",
        "label": "Gmail, Calendar, Drive and Docs",
        "description": "Use standard Google APIs with your own Google OAuth app."
      },
      "grantKinds": [
        "user",
        "organization"
      ],
      "ownershipModes": [
        "customer"
      ],
      "whenToUse": "Connect directly to standard Google APIs; no Google Workspace MCP preview enrollment is required.",
      "defaults": {
        "serverUrl": "https://www.googleapis.com",
        "authorizationEndpoint": "https://accounts.google.com/o/oauth2/v2/auth",
        "tokenEndpoint": "https://oauth2.googleapis.com/token",
        "metadataUrl": "https://accounts.google.com/.well-known/openid-configuration",
        "scopesHint": [
          "https://www.googleapis.com/auth/gmail.readonly",
          "https://www.googleapis.com/auth/gmail.compose",
          "https://www.googleapis.com/auth/drive.readonly",
          "https://www.googleapis.com/auth/drive.file",
          "https://www.googleapis.com/auth/documents.readonly",
          "https://www.googleapis.com/auth/documents",
          "https://www.googleapis.com/auth/calendar.calendarlist.readonly",
          "https://www.googleapis.com/auth/calendar.events.freebusy",
          "https://www.googleapis.com/auth/calendar.events.readonly",
          "https://www.googleapis.com/auth/calendar.events"
        ],
        "oauthAuthorizationParams": {
          "access_type": "offline",
          "prompt": "consent"
        }
      },
      "guidanceMd": "Enable Gmail, Calendar, Drive and Google Docs APIs in your Google Cloud project. Register the callback URI shown here as a Web application OAuth client. Choose services and access before signing in. Agents use the granted APIs through Paperclip\u2019s existing tool permissions. Gmail write access creates drafts; sending is not included.",
      "consoleLinks": {
        "register": "https://console.cloud.google.com/auth/clients",
        "docs": "https://developers.google.com/workspace/guides/enable-apis"
      },
      "riskTier": "S4",
      "oauthClientSecretRequired": true
    },
    {
      "key": "paperclip-workspace",
      "label": "Connect with Paperclip",
      "transport": "mcp_remote",
      "auth": "oauth",
      "oauthStrategy": "paperclip_cloud_connector",
      "connectorProfile": "workspace.all",
      "capabilityProfile": {
        "key": "workspace",
        "label": "Google Workspace",
        "description": "Choose services and read or write access before signing in."
      },
      "grantKinds": [
        "user",
        "organization"
      ],
      "ownershipModes": [
        "platform_shared"
      ],
      "whenToUse": "Use one Paperclip-managed sign-in for your selected Google services.",
      "defaults": {
        "serverUrl": "https://workspacemcp.googleapis.com/mcp/v1",
        "scopesHint": [
          "https://www.googleapis.com/auth/gmail.readonly",
          "https://www.googleapis.com/auth/gmail.compose",
          "https://www.googleapis.com/auth/drive.readonly",
          "https://www.googleapis.com/auth/drive.file",
          "https://www.googleapis.com/auth/documents.readonly",
          "https://www.googleapis.com/auth/documents",
          "https://www.googleapis.com/auth/spreadsheets.readonly",
          "https://www.googleapis.com/auth/spreadsheets",
          "https://www.googleapis.com/auth/presentations.readonly",
          "https://www.googleapis.com/auth/presentations",
          "https://www.googleapis.com/auth/calendar.calendarlist.readonly",
          "https://www.googleapis.com/auth/calendar.events.freebusy",
          "https://www.googleapis.com/auth/calendar.events.readonly",
          "https://www.googleapis.com/auth/calendar.events"
        ]
      },
      "guidanceMd": "Google Workspace MCP Developer Preview enrollment is required for this method. Choose Gmail, Drive, or Calendar and their access level before signing in. Only selected and granted actions are available.",
      "riskTier": "S4"
    },
    {
      "key": "customer-workspace-oauth",
      "label": "Use your own Google OAuth app",
      "transport": "mcp_remote",
      "auth": "oauth",
      "capabilityProfile": {
        "key": "workspace",
        "label": "Google Workspace",
        "description": "Choose services and read or write access before signing in."
      },
      "grantKinds": [
        "user",
        "organization"
      ],
      "ownershipModes": [
        "customer"
      ],
      "whenToUse": "Use one customer-owned Google OAuth client for your selected Google services.",
      "defaults": {
        "serverUrl": "https://workspacemcp.googleapis.com/mcp/v1",
        "authorizationEndpoint": "https://accounts.google.com/o/oauth2/v2/auth",
        "tokenEndpoint": "https://oauth2.googleapis.com/token",
        "metadataUrl": "https://accounts.google.com/.well-known/openid-configuration",
        "scopesHint": [
          "https://www.googleapis.com/auth/gmail.readonly",
          "https://www.googleapis.com/auth/gmail.compose",
          "https://www.googleapis.com/auth/drive.readonly",
          "https://www.googleapis.com/auth/drive.file",
          "https://www.googleapis.com/auth/documents.readonly",
          "https://www.googleapis.com/auth/documents",
          "https://www.googleapis.com/auth/spreadsheets.readonly",
          "https://www.googleapis.com/auth/spreadsheets",
          "https://www.googleapis.com/auth/presentations.readonly",
          "https://www.googleapis.com/auth/presentations",
          "https://www.googleapis.com/auth/calendar.calendarlist.readonly",
          "https://www.googleapis.com/auth/calendar.events.freebusy",
          "https://www.googleapis.com/auth/calendar.events.readonly",
          "https://www.googleapis.com/auth/calendar.events"
        ],
        "oauthAuthorizationParams": {
          "access_type": "offline",
          "prompt": "consent"
        }
      },
      "guidanceMd": "Google Workspace MCP Developer Preview enrollment is required for this method. Enable the Google Workspace MCP APIs and register Paperclip's callback URI. Choose which permissions to grant on Google's consent screen; declined permissions disable only the corresponding actions.",
      "consoleLinks": {
        "register": "https://console.cloud.google.com/auth/clients",
        "docs": "https://developers.google.com/workspace/guides/configure-mcp-servers"
      },
      "riskTier": "S4"
    }
  ]
}
